@@ solution
#include <stdlib.h>
#include <string.h>

struct RcStr {
    int refs;
    char text[];              /* flexible array member: the string lives in the same block */
};

RcStr *rcNew(const char *s) {
    size_t n = strlen(s) + 1;
    RcStr *r = malloc(sizeof *r + n);
    if (r == NULL) return NULL;
    r->refs = 1;
    memcpy(r->text, s, n);
    return r;
}

RcStr *rcRetain(RcStr *r) {
    r->refs++;
    return r;
}

void rcRelease(RcStr *r) {
    if (r != NULL && --r->refs == 0)
        free(r);
}

const char *rcGet(const RcStr *r) {
    return r->text;
}

int rcCount(const RcStr *r) {
    return r->refs;
}
