#include "lc_driver.h"
#include <stdio.h>

static char *borrowed_key(const char *text)
{
    char *k = (char *)lc_harness_alloc(strlen(text) + 1);
    memcpy(k, text, strlen(text) + 1);
    lc_make_readonly(k);
    return k;
}

int main(void)
{
    while (lc_next_case()) {
        int nb = lc_read_int();
        const LcJson *ops = lc_read_json(), *args = lc_read_json();
        int n = lc_json_len(ops), i, j;
        HashMap *m;
        if (nb < 1) lc_abort_case("Invalid test case", "buckets must be at least 1.");
        if (lc_json_len(args) != n) lc_abort_case("Invalid test case", "operations and arguments must have the same length.");
        m = hmCreate(nb);
        if (!m) {
            lc_fail("hmCreate returned NULL.");
            lc_out_null();
            lc_end_case();
            continue;
        }
        lc_out_begin();
        for (i = 0; i < n; i++) {
            const char *op = lc_json_str(lc_json_at(ops, i));
            const LcJson *arg = lc_json_at(args, i);
            if (strcmp(op, "put") == 0) {
                char *k = borrowed_key(lc_json_str(lc_json_at(arg, 0)));
                hmPut(m, k, lc_json_int(lc_json_at(arg, 1)));
                lc_harness_release(k);
                lc_out_null();
            } else if (strcmp(op, "get") == 0) {
                char *k = borrowed_key(lc_json_str(lc_json_at(arg, 0)));
                int v = -777;
                bool found = hmGet(m, k, &v);
                lc_harness_release(k);
                if (found) lc_out_int(v);
                else lc_out_null();
            } else if (strcmp(op, "remove") == 0) {
                char *k = borrowed_key(lc_json_str(lc_json_at(arg, 0)));
                bool ok = hmRemove(m, k);
                lc_harness_release(k);
                lc_out_bool(ok);
            } else if (strcmp(op, "size") == 0) {
                lc_out_int(hmSize(m));
            } else if (strcmp(op, "putRange") == 0 || strcmp(op, "sumRange") == 0) {
                const char *prefix = lc_json_str(lc_json_at(arg, 0));
                int count = lc_json_int(lc_json_at(arg, 1));
                long long sum = 0;
                char text[64];
                for (j = 0; j < count; j++) {
                    char *k;
                    snprintf(text, sizeof text, "%s%d", prefix, j);
                    k = borrowed_key(text);
                    if (op[0] == 'p') {
                        hmPut(m, k, j);
                    } else {
                        int v = 0;
                        if (hmGet(m, k, &v)) sum += v;
                    }
                    lc_harness_release(k);
                }
                if (op[0] == 'p') lc_out_null();
                else lc_out_int(sum);
            } else {
                lc_abort_case("Invalid test case", "Unknown operation \"%s\".", op);
            }
        }
        lc_out_end();
        hmFree(m);
        lc_end_case();
    }
    return lc_finish();
}
