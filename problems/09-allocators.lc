@@ solution
#include <stddef.h>
#include <stdint.h>

typedef struct Header {
    size_t size;      /* bytes in this block, header included */
    size_t free;      /* 1 if free, 0 if in use */
} Header;

static unsigned char *heapStart;
static size_t heapSize;

static Header *nextHeader(Header *h) {
    unsigned char *n = (unsigned char *)h + h->size;
    return n < heapStart + heapSize ? (Header *)n : NULL;
}

void heapInit(void *buffer, size_t size) {
    heapStart = buffer;
    heapSize = size & ~(size_t)15;
    Header *h = (Header *)heapStart;
    h->size = heapSize;
    h->free = 1;
}

void *heapAlloc(size_t size) {
    if (size == 0 || size > heapSize) return NULL;
    size_t need = sizeof(Header) + ((size + 15) & ~(size_t)15);
    for (Header *h = (Header *)heapStart; h != NULL; h = nextHeader(h)) {
        if (!h->free || h->size < need) continue;
        if (h->size - need >= sizeof(Header) + 16) {      /* split off the rest */
            Header *rest = (Header *)((unsigned char *)h + need);
            rest->size = h->size - need;
            rest->free = 1;
            h->size = need;
        }
        h->free = 0;
        return h + 1;                                    /* memory right after the header */
    }
    return NULL;
}

void heapFree(void *ptr) {
    if (ptr == NULL) return;
    ((Header *)ptr - 1)->free = 1;
    /* coalesce: merge every run of adjacent free blocks */
    for (Header *h = (Header *)heapStart; h != NULL; h = nextHeader(h)) {
        if (!h->free) continue;
        Header *n;
        while ((n = nextHeader(h)) != NULL && n->free)
            h->size += n->size;
    }
}
@@ driver
#include "lc_driver.h"
#include <stdint.h>

typedef struct {
    unsigned char *p;
    size_t size;
    int live;
} Blk;

static unsigned char *g_buf;
static size_t g_cap;
static Blk *g_blk;
static int g_nblk, g_capblk;

static unsigned char pattern(int id) { return (unsigned char)(0x21 + id % 190); }

static int intact(const Blk *b, int id)
{
    size_t k;
    for (k = 0; k < b->size; k++)
        if (b->p[k] != pattern(id)) return 0;
    return 1;
}

static int track(unsigned char *p, size_t size)
{
    int j, id;
    if (g_nblk == g_capblk) {
        Blk *nb = (Blk *)lc_harness_alloc(sizeof(Blk) * (size_t)(g_capblk * 2));
        memcpy(nb, g_blk, sizeof(Blk) * (size_t)g_capblk);
        g_blk = nb;
        g_capblk *= 2;
    }
    id = g_nblk++;
    g_blk[id].p = p;
    g_blk[id].size = size;
    g_blk[id].live = p != NULL;
    if (!p) return id;
    if ((uintptr_t)p % 16 != 0) lc_fail("heapAlloc(%zu) returned an address that is not 16-byte aligned.", size);
    if (p < g_buf || p + size > g_buf + g_cap)
        lc_abort_case("Block outside the heap", "heapAlloc(%zu) returned a block that does not lie inside the buffer given to heapInit.", size);
    for (j = 0; j < id; j++)
        if (g_blk[j].live && p < g_blk[j].p + g_blk[j].size && g_blk[j].p < p + size)
            lc_abort_case("Overlapping blocks", "heapAlloc(%zu) returned a block that overlaps block %d, which is still in use.", size, j);
    memset(p, pattern(id), size);
    return id;
}

static void release(int id)
{
    Blk *b = &g_blk[id];
    if (!b->live) return;
    if (!intact(b, id))
        lc_fail("Block %d was modified while it was in use. Your allocator wrote into user memory (for example a header placed inside another block).", id);
    b->live = 0;
    heapFree(b->p);
}

int main(void)
{
    while (lc_next_case()) {
        int cap = lc_read_int();
        const LcJson *ops = lc_read_json(), *args = lc_read_json();
        int n = lc_json_len(ops), i, j;
        long long before;
        if (cap <= 0 || cap % 4096 != 0 || cap > 16384) lc_abort_case("Invalid test case", "capacity must be a multiple of 4096, at most 16384.");
        if (lc_json_len(args) != n) lc_abort_case("Invalid test case", "operations and arguments must have the same length.");
        g_cap = (size_t)cap;
        g_buf = (unsigned char *)lc_harness_alloc(g_cap);
        g_capblk = 64;
        g_nblk = 0;
        g_blk = (Blk *)lc_harness_alloc(sizeof(Blk) * (size_t)g_capblk);
        before = lc_alloc_count();
        heapInit(g_buf, g_cap);
        lc_out_begin();
        for (i = 0; i < n; i++) {
            const char *op = lc_json_str(lc_json_at(ops, i));
            const LcJson *a = lc_json_at(args, i);
            if (strcmp(op, "alloc") == 0) {
                size_t size = (size_t)lc_json_ll(lc_json_at(a, 0));
                unsigned char *p = (unsigned char *)heapAlloc(size);
                track(p, size);
                lc_out_bool(p != NULL);
            } else if (strcmp(op, "free") == 0) {
                int id = lc_json_int(lc_json_at(a, 0));
                if (id < 0 || id >= g_nblk) lc_abort_case("Invalid test case", "There is no allocation number %d.", id);
                release(id);
                lc_out_null();
            } else if (strcmp(op, "allocMany") == 0) {
                int count = lc_json_int(lc_json_at(a, 0)), got = 0;
                size_t size = (size_t)lc_json_ll(lc_json_at(a, 1));
                for (j = 0; j < count; j++) {
                    unsigned char *p = (unsigned char *)heapAlloc(size);
                    track(p, size);
                    got += p != NULL;
                }
                lc_out_int(got);
            } else if (strcmp(op, "freeAll") == 0) {
                for (j = 0; j < g_nblk; j++) release(j);
                lc_out_null();
            } else if (strcmp(op, "check") == 0) {
                int ok = 1;
                for (j = 0; j < g_nblk; j++)
                    if (g_blk[j].live && !intact(&g_blk[j], j)) ok = 0;
                if (!ok) lc_fail("A block in use was modified by the allocator.");
                lc_out_bool(ok);
            } else if (strcmp(op, "big") == 0) {
                size_t size = g_cap - 256;
                unsigned char *p = (unsigned char *)heapAlloc(size);
                if (p) {
                    int id = track(p, size);
                    release(id);
                }
                lc_out_bool(p != NULL);
            } else {
                lc_abort_case("Invalid test case", "Unknown operation \"%s\".", op);
            }
        }
        lc_out_end();
        if (lc_alloc_count() != before)
            lc_fail("Your allocator called the real malloc. Everything must come from the buffer passed to heapInit.");
        lc_end_case();
    }
    return lc_finish();
}
