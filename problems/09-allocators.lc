@@ solution
#include <stddef.h>
#include <stdint.h>

void arenaInit(Arena *a, void *buffer, size_t capacity) {
    a->base = buffer;
    a->capacity = capacity;
    a->used = 0;
}

void *arenaAlloc(Arena *a, size_t size, size_t align) {
    uintptr_t start = (uintptr_t)a->base + a->used;
    uintptr_t aligned = (start + (align - 1)) & ~(uintptr_t)(align - 1);
    size_t offset = (size_t)(aligned - (uintptr_t)a->base);
    if (offset > a->capacity || size > a->capacity - offset)
        return NULL;
    a->used = offset + size;
    return a->base + offset;
}

void arenaReset(Arena *a) {
    a->used = 0;
}
@@ driver
#include "lc_driver.h"
#include <stdint.h>

int main(void)
{
    while (lc_next_case()) {
        int cap = lc_read_int();
        const LcJson *ops = lc_read_json(), *args = lc_read_json();
        int n = lc_json_len(ops), i, j, live = 0;
        unsigned char *buf;
        unsigned char **starts;
        size_t *sizes;
        long long before;
        Arena a;
        if (cap <= 0 || cap % 64 != 0 || cap > 4096) lc_abort_case("Invalid test case", "capacity must be a positive multiple of 64, at most 4096.");
        if (lc_json_len(args) != n) lc_abort_case("Invalid test case", "operations and arguments must have the same length.");
        buf = (unsigned char *)lc_harness_alloc((size_t)cap);
        starts = (unsigned char **)lc_harness_alloc(sizeof(*starts) * (size_t)(n + 1));
        sizes = (size_t *)lc_harness_alloc(sizeof(*sizes) * (size_t)(n + 1));
        memset(&a, 0xCD, sizeof a);
        before = lc_alloc_count();
        arenaInit(&a, buf, (size_t)cap);
        lc_out_begin();
        for (i = 0; i < n; i++) {
            const char *op = lc_json_str(lc_json_at(ops, i));
            const LcJson *arg = lc_json_at(args, i);
            if (strcmp(op, "alloc") == 0) {
                size_t size = (size_t)lc_json_ll(lc_json_at(arg, 0)), align = (size_t)lc_json_ll(lc_json_at(arg, 1));
                unsigned char *p = (unsigned char *)arenaAlloc(&a, size, align);
                if (!p) {
                    lc_out_null();
                    continue;
                }
                if (p < buf || p + size > buf + cap) {
                    lc_fail("arenaAlloc(%zu, %zu) returned a block that does not lie inside the buffer.", size, align);
                    lc_out_null();
                    continue;
                }
                if ((uintptr_t)p % align != 0) lc_fail("arenaAlloc(%zu, %zu) returned an address that is not a multiple of %zu.", size, align, align);
                for (j = 0; j < live; j++)
                    if (p < starts[j] + sizes[j] && starts[j] < p + size)
                        lc_fail("arenaAlloc(%zu, %zu) returned a block that overlaps a previous allocation.", size, align);
                memset(p, 0x5A, size);
                starts[live] = p;
                sizes[live] = size;
                live++;
                lc_out_int((long long)(p - buf));
            } else if (strcmp(op, "reset") == 0) {
                arenaReset(&a);
                live = 0;
                lc_out_null();
            } else if (strcmp(op, "used") == 0) {
                lc_out_int((long long)a.used);
            } else {
                lc_abort_case("Invalid test case", "Unknown operation \"%s\".", op);
            }
        }
        lc_out_end();
        if (lc_alloc_count() != before) lc_fail("The arena called malloc. It must hand out pieces of the buffer it was given.");
        lc_end_case();
    }
    return lc_finish();
}
