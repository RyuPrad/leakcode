@@ solution
#include <stddef.h>
#include <stdlib.h>

struct Pool {
    unsigned char *memory;
    void *freeList;
    int available;
};

Pool *poolCreate(size_t blockSize, int blockCount) {
    Pool *p = malloc(sizeof *p);
    if (p == NULL) return NULL;
    p->memory = malloc(blockSize * (size_t)blockCount);
    if (p->memory == NULL) {
        free(p);
        return NULL;
    }
    /* chain every block into the free list: block i points to block i + 1 */
    p->freeList = NULL;
    for (int i = blockCount - 1; i >= 0; i--) {
        void **block = (void **)(p->memory + (size_t)i * blockSize);
        *block = p->freeList;
        p->freeList = block;
    }
    p->available = blockCount;
    return p;
}

void *poolAlloc(Pool *p) {
    void **block = p->freeList;
    if (block == NULL) return NULL;
    p->freeList = *block;          /* the next free block */
    p->available--;
    return block;
}

void poolFree(Pool *p, void *block) {
    if (block == NULL) return;
    *(void **)block = p->freeList; /* link it in front */
    p->freeList = block;
    p->available++;
}

int poolAvailable(const Pool *p) {
    return p->available;
}

void poolDestroy(Pool *p) {
    if (p == NULL) return;
    free(p->memory);
    free(p);
}
@@ driver
#include "lc_driver.h"
#include <stdint.h>

static int intact(unsigned char *b, size_t size, unsigned char pat)
{
    size_t k;
    for (k = 0; k < size; k++)
        if (b[k] != pat) return 0;
    return 1;
}

int main(void)
{
    while (lc_next_case()) {
        int bs = lc_read_int(), count = lc_read_int();
        const LcJson *ops = lc_read_json(), *args = lc_read_json();
        int n = lc_json_len(ops), i, j, made = 0, capb = lc_json_len(ops) + count + 1;
        unsigned char **blocks;
        unsigned char *alive;
        long long allocs, frees;
        Pool *p;
        if (bs < 8 || bs % 8 != 0 || count < 1) lc_abort_case("Invalid test case", "blockSize must be a multiple of 8 (>= 8) and blockCount >= 1.");
        if (lc_json_len(args) != n) lc_abort_case("Invalid test case", "operations and arguments must have the same length.");
        blocks = (unsigned char **)lc_harness_alloc(sizeof(*blocks) * (size_t)capb);
        alive = (unsigned char *)lc_harness_alloc((size_t)capb);
        p = poolCreate((size_t)bs, count);
        if (!p) {
            lc_fail("poolCreate returned NULL.");
            lc_out_null();
            lc_end_case();
            continue;
        }
        allocs = lc_alloc_count();
        frees = lc_free_count();
        lc_out_begin();
        for (i = 0; i < n; i++) {
            const char *op = lc_json_str(lc_json_at(ops, i));
            const LcJson *arg = lc_json_at(args, i);
            if (strcmp(op, "alloc") == 0) {
                unsigned char *b = (unsigned char *)poolAlloc(p);
                if (!b) {
                    lc_out_null();
                    continue;
                }
                if (made == capb) lc_abort_case("Pool never runs out", "poolAlloc returned more blocks than the pool holds.");
                if ((uintptr_t)b % 8 != 0) lc_fail("poolAlloc returned an address that is not 8-byte aligned.");
                for (j = 0; j < made; j++)
                    if (alive[j] && b < blocks[j] + bs && blocks[j] < b + bs)
                        lc_abort_case("Overlapping blocks", "poolAlloc returned a block that overlaps block %d, which is still in use.", j);
                memset(b, 0x11 + made % 200, (size_t)bs);
                blocks[made] = b;
                alive[made] = 1;
                lc_out_int(made++);
            } else if (strcmp(op, "free") == 0) {
                int h = lc_json_int(lc_json_at(arg, 0));
                if (h < 0 || h >= made || !alive[h]) lc_abort_case("Invalid test case", "Block %d is not in use.", h);
                if (!intact(blocks[h], (size_t)bs, (unsigned char)(0x11 + h % 200)))
                    lc_fail("Block %d was overwritten while it was in use: blocks overlap, or the free list writes into used blocks.", h);
                alive[h] = 0;
                poolFree(p, blocks[h]);
                lc_out_null();
            } else if (strcmp(op, "available") == 0) {
                lc_out_int(poolAvailable(p));
            } else if (strcmp(op, "check") == 0) {
                int ok = 1;
                for (j = 0; j < made; j++)
                    if (alive[j] && !intact(blocks[j], (size_t)bs, (unsigned char)(0x11 + j % 200))) ok = 0;
                if (!ok) lc_fail("A block in use was overwritten: blocks overlap, or the free list writes into used blocks.");
                lc_out_bool(ok);
            } else if (strcmp(op, "allocAll") == 0 || strcmp(op, "freeAll") == 0) {
                int got = 0;
                if (op[0] == 'a') {
                    unsigned char *b;
                    while ((b = (unsigned char *)poolAlloc(p)) != NULL) {
                        if (got >= count) lc_abort_case("Pool never runs out", "poolAlloc returned more blocks than the pool holds.");
                        if (made == capb) {
                            unsigned char **nb = (unsigned char **)lc_harness_alloc(sizeof(*nb) * (size_t)capb * 2);
                            unsigned char *na = (unsigned char *)lc_harness_alloc((size_t)capb * 2);
                            memcpy(nb, blocks, sizeof(*nb) * (size_t)capb);
                            memcpy(na, alive, (size_t)capb);
                            blocks = nb;
                            alive = na;
                            capb *= 2;
                        }
                        memset(b, 0x11 + made % 200, (size_t)bs);
                        blocks[made] = b;
                        alive[made++] = 1;
                        got++;
                    }
                    lc_out_int(got);
                } else {
                    for (j = 0; j < made; j++)
                        if (alive[j]) {
                            alive[j] = 0;
                            poolFree(p, blocks[j]);
                        }
                    lc_out_null();
                }
            } else {
                lc_abort_case("Invalid test case", "Unknown operation \"%s\".", op);
            }
        }
        lc_out_end();
        if (lc_alloc_count() != allocs || lc_free_count() != frees)
            lc_fail("poolAlloc/poolFree called malloc or free. A pool hands out pieces of the memory it allocated in poolCreate.");
        poolDestroy(p);
        lc_end_case();
    }
    return lc_finish();
}
