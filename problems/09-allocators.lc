@@ solution
#include <stdlib.h>

#define MAX_KEY 10000

typedef struct Node {
    int key, value;
    struct Node *prev, *next;
} Node;

struct LRUCache {
    int capacity, size;
    Node head;                  /* sentinel of a circular doubly linked list */
    Node *index[MAX_KEY + 1];
};

static void listRemove(Node *n) {
    n->prev->next = n->next;
    n->next->prev = n->prev;
}

static void pushFront(LRUCache *c, Node *n) {
    n->next = c->head.next;
    n->prev = &c->head;
    c->head.next->prev = n;
    c->head.next = n;
}

LRUCache *lruCreate(int capacity) {
    LRUCache *c = calloc(1, sizeof *c);       /* index[] starts all NULL */
    if (c == NULL) return NULL;
    c->capacity = capacity;
    c->head.next = c->head.prev = &c->head;
    return c;
}

int lruGet(LRUCache *c, int key) {
    Node *n = c->index[key];
    if (n == NULL) return -1;
    listRemove(n);
    pushFront(c, n);
    return n->value;
}

void lruPut(LRUCache *c, int key, int value) {
    Node *n = c->index[key];
    if (n != NULL) {
        n->value = value;
        listRemove(n);
        pushFront(c, n);
        return;
    }
    if (c->size == c->capacity) {
        Node *old = c->head.prev;              /* least recently used */
        listRemove(old);
        c->index[old->key] = NULL;
        free(old);
        c->size--;
    }
    n = malloc(sizeof *n);
    if (n == NULL) return;
    n->key = key;
    n->value = value;
    pushFront(c, n);
    c->index[key] = n;
    c->size++;
}

void lruFree(LRUCache *c) {
    if (c == NULL) return;
    Node *n = c->head.next;
    while (n != &c->head) {
        Node *next = n->next;
        free(n);
        n = next;
    }
    free(c);
}
@@ driver
#include "lc_driver.h"

int main(void)
{
    while (lc_next_case()) {
        int cap = lc_read_int();
        const LcJson *ops = lc_read_json(), *args = lc_read_json();
        int n = lc_json_len(ops), i, k;
        LRUCache *c;
        if (cap < 1) lc_abort_case("Invalid test case", "capacity must be at least 1.");
        if (lc_json_len(args) != n) lc_abort_case("Invalid test case", "operations and arguments must have the same length.");
        c = lruCreate(cap);
        if (!c) {
            lc_fail("lruCreate returned NULL.");
            lc_out_null();
            lc_end_case();
            continue;
        }
        lc_out_begin();
        for (i = 0; i < n; i++) {
            const char *op = lc_json_str(lc_json_at(ops, i));
            const LcJson *a = lc_json_at(args, i);
            if (strcmp(op, "get") == 0) {
                lc_out_int(lruGet(c, lc_json_int(lc_json_at(a, 0))));
            } else if (strcmp(op, "put") == 0) {
                lruPut(c, lc_json_int(lc_json_at(a, 0)), lc_json_int(lc_json_at(a, 1)));
                lc_out_null();
            } else if (strcmp(op, "putRange") == 0) {
                int lo = lc_json_int(lc_json_at(a, 0)), hi = lc_json_int(lc_json_at(a, 1));
                for (k = lo; k < hi; k++) lruPut(c, k, 2 * k);
                lc_out_null();
            } else if (strcmp(op, "getSum") == 0) {
                int lo = lc_json_int(lc_json_at(a, 0)), hi = lc_json_int(lc_json_at(a, 1));
                long long sum = 0;
                for (k = lo; k < hi; k++) sum += lruGet(c, k);
                lc_out_int(sum);
            } else {
                lc_abort_case("Invalid test case", "Unknown operation \"%s\".", op);
            }
        }
        lc_out_end();
        lruFree(c);
        lc_end_case();
    }
    return lc_finish();
}
