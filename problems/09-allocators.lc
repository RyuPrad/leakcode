@@ solution
#include <stdbool.h>
#include <stdlib.h>
#include <string.h>

typedef struct Entry {
    char *key;
    int value;
    struct Entry *next;
} Entry;

struct HashMap {
    Entry **buckets;
    int nbuckets;
    int size;
};

static unsigned long hashString(const char *s) {
    unsigned long h = 5381;
    while (*s) h = h * 33 + (unsigned char)*s++;
    return h;
}

HashMap *hmCreate(int buckets) {
    HashMap *m = malloc(sizeof *m);
    if (m == NULL) return NULL;
    m->buckets = calloc(buckets, sizeof *m->buckets);   /* all chains empty */
    if (m->buckets == NULL) {
        free(m);
        return NULL;
    }
    m->nbuckets = buckets;
    m->size = 0;
    return m;
}

static Entry **findLink(const HashMap *m, const char *key) {
    Entry **link = &m->buckets[hashString(key) % m->nbuckets];
    while (*link != NULL && strcmp((*link)->key, key) != 0)
        link = &(*link)->next;
    return link;                                        /* *link is the entry or NULL */
}

void hmPut(HashMap *m, const char *key, int value) {
    Entry **link = findLink(m, key);
    if (*link != NULL) {
        (*link)->value = value;
        return;
    }
    Entry *e = malloc(sizeof *e);
    if (e == NULL) return;
    e->key = strdup(key);
    if (e->key == NULL) {
        free(e);
        return;
    }
    e->value = value;
    e->next = NULL;
    *link = e;
    m->size++;
}

bool hmGet(const HashMap *m, const char *key, int *out) {
    Entry *e = *findLink(m, key);
    if (e == NULL) return false;
    *out = e->value;
    return true;
}

bool hmRemove(HashMap *m, const char *key) {
    Entry **link = findLink(m, key);
    Entry *e = *link;
    if (e == NULL) return false;
    *link = e->next;
    free(e->key);
    free(e);
    m->size--;
    return true;
}

int hmSize(const HashMap *m) {
    return m->size;
}

void hmFree(HashMap *m) {
    if (m == NULL) return;
    for (int i = 0; i < m->nbuckets; i++) {
        Entry *e = m->buckets[i];
        while (e != NULL) {
            Entry *next = e->next;
            free(e->key);
            free(e);
            e = next;
        }
    }
    free(m->buckets);
    free(m);
}
