@@ description
`makeLabel("item", 7)` should return the new string `"item-7"`, which the caller frees.

```c
char *makeLabel(const char *prefix, int id);
```

Sometimes the label prints correctly, sometimes it is garbage, and the program crashes when the caller frees it. **Find and fix the bug.**

Read the compiler warnings: this time the compiler noticed the problem before the program even ran.
@@ prelude
char *makeLabel(const char *prefix, int id);
@@ starter
#include <stdio.h>
#include <stdlib.h>

char *makeLabel(const char *prefix, int id) {
    char buf[64];
    snprintf(buf, sizeof buf, "%s-%d", prefix, id);
    return buf;
}
@@ solution
#include <stdio.h>
#include <stdlib.h>

char *makeLabel(const char *prefix, int id) {
    int len = snprintf(NULL, 0, "%s-%d", prefix, id);   /* measure */
    char *label = malloc((size_t)len + 1);
    if (label == NULL) return NULL;
    snprintf(label, (size_t)len + 1, "%s-%d", prefix, id);
    return label;
}
@@ driver
#include "lc_driver.h"

int main(void)
{
    while (lc_next_case()) {
        char *prefix = lc_read_str();
        int id = lc_read_int();
        char *label;
        lc_make_readonly(prefix);
        label = makeLabel(prefix, id);
        lc_out_str(label);
        if (label) LC_FREE_RESULT(label, "the string returned by makeLabel()");
        lc_end_case();
    }
    return lc_finish();
}
@@ tests
