@@ solution
#include <stdbool.h>
#include <stdlib.h>

struct RingBuffer {
    int *items;
    int capacity;
    int head;
    int count;
};

RingBuffer *rbCreate(int capacity) {
    RingBuffer *q = malloc(sizeof *q);
    if (q == NULL) return NULL;
    q->items = malloc(capacity * sizeof *q->items);
    if (q->items == NULL) {
        free(q);
        return NULL;
    }
    q->capacity = capacity;
    q->head = 0;
    q->count = 0;
    return q;
}

bool rbEnqueue(RingBuffer *q, int value) {
    if (q->count == q->capacity) return false;
    q->items[(q->head + q->count) % q->capacity] = value;
    q->count++;
    return true;
}

bool rbDequeue(RingBuffer *q) {
    if (q->count == 0) return false;
    q->head = (q->head + 1) % q->capacity;
    q->count--;
    return true;
}

int rbFront(const RingBuffer *q) {
    return q->count ? q->items[q->head] : -1;
}

int rbRear(const RingBuffer *q) {
    return q->count ? q->items[(q->head + q->count - 1) % q->capacity] : -1;
}

bool rbIsEmpty(const RingBuffer *q) {
    return q->count == 0;
}

bool rbIsFull(const RingBuffer *q) {
    return q->count == q->capacity;
}

void rbFree(RingBuffer *q) {
    if (q == NULL) return;
    free(q->items);
    free(q);
}
@@ driver
#include "lc_driver.h"

int main(void)
{
    while (lc_next_case()) {
        int cap = lc_read_int();
        const LcJson *ops = lc_read_json(), *args = lc_read_json();
        int n = lc_json_len(ops), i;
        long long afterCreate;
        RingBuffer *q;
        if (lc_json_len(args) != n) lc_abort_case("Invalid test case", "operations and arguments must have the same length.");
        q = rbCreate(cap);
        if (!q) {
            lc_fail("rbCreate returned NULL.");
            lc_out_null();
            lc_end_case();
            continue;
        }
        afterCreate = lc_alloc_count();
        lc_out_begin();
        for (i = 0; i < n; i++) {
            const char *op = lc_json_str(lc_json_at(ops, i));
            const LcJson *a = lc_json_at(args, i);
            if (strcmp(op, "enqueue") == 0) lc_out_bool(rbEnqueue(q, lc_json_int(lc_json_at(a, 0))));
            else if (strcmp(op, "dequeue") == 0) lc_out_bool(rbDequeue(q));
            else if (strcmp(op, "front") == 0) lc_out_int(rbFront(q));
            else if (strcmp(op, "rear") == 0) lc_out_int(rbRear(q));
            else if (strcmp(op, "isEmpty") == 0) lc_out_bool(rbIsEmpty(q));
            else if (strcmp(op, "isFull") == 0) lc_out_bool(rbIsFull(q));
            else lc_abort_case("Invalid test case", "Unknown operation \"%s\".", op);
        }
        lc_out_end();
        if (lc_alloc_count() != afterCreate)
            lc_fail("Your ring buffer allocated memory after rbCreate. A ring buffer reuses its fixed array.");
        rbFree(q);
        lc_end_case();
    }
    return lc_finish();
}
