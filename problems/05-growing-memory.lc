@@ solution
#include <stdlib.h>
#include <string.h>

struct StrBuilder {
    char *buf;
    int len;
    int cap;
};

StrBuilder *sbCreate(void) {
    StrBuilder *sb = calloc(1, sizeof *sb);   /* buf = NULL, len = cap = 0 */
    return sb;
}

static int reserve(StrBuilder *sb, int extra) {
    if (sb->len + extra <= sb->cap) return 1;
    int cap = sb->cap ? sb->cap : 16;
    while (cap < sb->len + extra) cap *= 2;
    char *bigger = realloc(sb->buf, cap);
    if (bigger == NULL) return 0;
    sb->buf = bigger;
    sb->cap = cap;
    return 1;
}

void sbAppend(StrBuilder *sb, const char *s) {
    int n = (int)strlen(s);
    if (!reserve(sb, n)) return;
    memcpy(sb->buf + sb->len, s, n);
    sb->len += n;
}

void sbAppendChar(StrBuilder *sb, char c) {
    if (!reserve(sb, 1)) return;
    sb->buf[sb->len++] = c;
}

int sbLength(const StrBuilder *sb) {
    return sb->len;
}

char *sbBuild(const StrBuilder *sb) {
    char *out = malloc(sb->len + 1);
    if (out == NULL) return NULL;
    if (sb->len) memcpy(out, sb->buf, sb->len);
    out[sb->len] = '\0';
    return out;
}

void sbFree(StrBuilder *sb) {
    if (sb == NULL) return;
    free(sb->buf);
    free(sb);
}
@@ driver
#include "lc_driver.h"
#include <math.h>

int main(void)
{
    while (lc_next_case()) {
        const LcJson *ops = lc_read_json(), *args = lc_read_json();
        int n = lc_json_len(ops), i, k, builds = 0;
        long long appended = 0, before = lc_alloc_count();
        StrBuilder *sb;
        if (lc_json_len(args) != n) lc_abort_case("Invalid test case", "operations and arguments must have the same length.");
        sb = sbCreate();
        if (!sb) {
            lc_fail("sbCreate returned NULL.");
            lc_out_null();
            lc_end_case();
            continue;
        }
        lc_out_begin();
        for (i = 0; i < n; i++) {
            const char *op = lc_json_str(lc_json_at(ops, i));
            const LcJson *a = lc_json_at(args, i);
            if (strcmp(op, "append") == 0 || strcmp(op, "appendRepeat") == 0) {
                int times = strcmp(op, "append") == 0 ? 1 : lc_json_int(lc_json_at(a, 1));
                for (k = 0; k < times; k++) {
                    char *s = lc_harness_str(lc_json_at(a, 0));
                    lc_make_readonly(s);
                    sbAppend(sb, s);
                    appended += (long long)strlen(s);
                    lc_harness_release(s);   /* the caller's string is gone after the call */
                }
                lc_out_null();
            } else if (strcmp(op, "appendChar") == 0) {
                const char *c = lc_json_str(lc_json_at(a, 0));
                sbAppendChar(sb, c[0]);
                appended++;
                lc_out_null();
            } else if (strcmp(op, "length") == 0) {
                lc_out_int(sbLength(sb));
            } else if (strcmp(op, "build") == 0) {
                char *s = sbBuild(sb);
                builds++;
                lc_out_str(s);
                if (s) LC_FREE_RESULT(s, "the string returned by sbBuild()");
            } else {
                lc_abort_case("Invalid test case", "Unknown operation \"%s\".", op);
            }
        }
        lc_out_end();
        if (appended >= 256) {
            long long allocs = lc_alloc_count() - before - builds;
            if ((double)allocs > 2.0 * log2((double)appended) + 8.0)
                lc_fail("Your builder made %lld allocations while %lld characters were appended. Grow the buffer geometrically (e.g. double it).",
                        allocs, appended);
        }
        sbFree(sb);
        lc_end_case();
    }
    return lc_finish();
}
