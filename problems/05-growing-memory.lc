@@ solution
#include <stdlib.h>

struct IntVec {
    int *data;
    int size;
    int capacity;
};

IntVec *vecCreate(void) {
    IntVec *v = malloc(sizeof *v);
    if (v == NULL) return NULL;
    v->data = NULL;
    v->size = 0;
    v->capacity = 0;
    return v;
}

void vecPush(IntVec *v, int value) {
    if (v->size == v->capacity) {
        int newCap = v->capacity ? v->capacity * 2 : 4;
        int *bigger = realloc(v->data, newCap * sizeof *bigger);
        if (bigger == NULL) return;          /* out of memory: keep the old array */
        v->data = bigger;
        v->capacity = newCap;
    }
    v->data[v->size++] = value;
}

int vecGet(const IntVec *v, int index) {
    return v->data[index];
}

void vecSet(IntVec *v, int index, int value) {
    v->data[index] = value;
}

int vecPop(IntVec *v) {
    return v->data[--v->size];
}

int vecSize(const IntVec *v) {
    return v->size;
}

void vecFree(IntVec *v) {
    if (v == NULL) return;
    free(v->data);
    free(v);
}
@@ driver
#include "lc_driver.h"
#include <math.h>

int main(void)
{
    while (lc_next_case()) {
        const LcJson *ops = lc_read_json(), *args = lc_read_json();
        int n = lc_json_len(ops), i, k, pushes = 0;
        long long before = lc_alloc_count();
        IntVec *v;
        if (lc_json_len(args) != n) lc_abort_case("Invalid test case", "operations and arguments must have the same length.");
        v = vecCreate();
        if (!v) {
            lc_fail("vecCreate returned NULL.");
            lc_out_null();
            lc_end_case();
            continue;
        }
        lc_out_begin();
        for (i = 0; i < n; i++) {
            const char *op = lc_json_str(lc_json_at(ops, i));
            const LcJson *a = lc_json_at(args, i);
            if (strcmp(op, "push") == 0) {
                vecPush(v, lc_json_int(lc_json_at(a, 0)));
                pushes++;
                lc_out_null();
            } else if (strcmp(op, "pushRange") == 0) {
                int lo = lc_json_int(lc_json_at(a, 0)), hi = lc_json_int(lc_json_at(a, 1));
                for (k = lo; k < hi; k++, pushes++) vecPush(v, k);
                lc_out_null();
            } else if (strcmp(op, "get") == 0) {
                lc_out_int(vecGet(v, lc_json_int(lc_json_at(a, 0))));
            } else if (strcmp(op, "set") == 0) {
                vecSet(v, lc_json_int(lc_json_at(a, 0)), lc_json_int(lc_json_at(a, 1)));
                lc_out_null();
            } else if (strcmp(op, "pop") == 0) {
                lc_out_int(vecPop(v));
            } else if (strcmp(op, "size") == 0) {
                lc_out_int(vecSize(v));
            } else {
                lc_abort_case("Invalid test case", "Unknown operation \"%s\".", op);
            }
        }
        lc_out_end();
        if (pushes >= 64) {
            long long allocs = lc_alloc_count() - before;
            if ((double)allocs > 2.0 * log2((double)pushes) + 8.0)
                lc_fail("Your vector made %lld allocations for %d pushes. Grow the capacity geometrically (e.g. double it) so pushes are amortized O(1).",
                        allocs, pushes);
        }
        vecFree(v);
        lc_end_case();
    }
    return lc_finish();
}
