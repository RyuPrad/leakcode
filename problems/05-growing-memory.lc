@@ editorial
## Approach: a growable char buffer

```c
struct StrBuilder { char *buf; int len; int cap; };

static int reserve(StrBuilder *sb, int extra) {      // make room for extra chars
    if (sb->len + extra <= sb->cap) return 1;
    int cap = sb->cap ? sb->cap : 16;
    while (cap < sb->len + extra) cap *= 2;
    char *bigger = realloc(sb->buf, cap);
    if (bigger == NULL) return 0;
    sb->buf = bigger;
    sb->cap = cap;
    return 1;
}

void sbAppend(StrBuilder *sb, const char *s) {
    int n = (int)strlen(s);
    if (!reserve(sb, n)) return;
    memcpy(sb->buf + sb->len, s, n);    // copy: s is only borrowed
    sb->len += n;
}

char *sbBuild(const StrBuilder *sb) {
    char *out = malloc(sb->len + 1);    // a new block for the caller
    if (out == NULL) return NULL;
    if (sb->len) memcpy(out, sb->buf, sb->len);
    out[sb->len] = '\0';
    return out;
}
```

### Borrowing vs owning
A `const char *` parameter is a *loan*: valid while the function runs, with no promise about later. If a data structure needs the data later, it must **copy** it. Storing `sb->parts[i] = s` looks fine in a quick test, then breaks as soon as the caller reuses or frees its buffer.

### Why keep the buffer unterminated?
Tracking `len` means you never need `strlen` on your own buffer, and appends are O(length of the appended string). The `'\0'` is added only in `sbBuild`.

### `calloc` for zeroed structs
`calloc(1, sizeof *sb)` returns a zero-filled struct: `buf == NULL`, `len == cap == 0`, a convenient starting state.

**Complexity:** amortized O(k) per append of k characters; O(n) per build.

@@@ problem run-length-encoding
@@ meta
{
  "title": "Run-Length Encoding",
  "difficulty": "Medium",
  "topics": ["Strings", "malloc", "Sizing"],
  "params": [{"name": "s", "type": "string"}],
  "examples": [
    {"input": ["\"aaabccdddd\""], "output": "\"a3b1c2d4\""},
    {"input": ["\"aaaaaaaaaaaa\""], "output": "\"a12\"", "explanation": "Counts can have several digits."},
    {"input": ["\"\""], "output": "\"\""}
  ],
  "hints": [
    "You can't know the output size without looking at the runs. Either measure first, or grow a buffer.",
    "snprintf(NULL, 0, \"%d\", count) returns the number of digits count needs.",
    "Upper bound: every run produces at least 2 characters and at most 1 + digits, so 2 * strlen(s) + 1 bytes always suffice."
  ],
  "constraints": ["0 <= strlen(s) <= 10^4", "s contains printable characters, no digits"],
  "memory": "Return a new block from `malloc`; the caller frees it."
}
@@ description
Compress `s` by replacing each run of identical characters with the character followed by the length of the run.

```c
char *rleEncode(const char *s);
```

`"aaabccdddd"` → `"a3b1c2d4"`.

The output's size depends on the input in a non-obvious way: a run of 9 takes 2 characters but a run of 10 takes 3. Getting the size right is the real exercise. Measure the result exactly before allocating, or start from a safe upper bound.
@@ prelude
char *rleEncode(const char *s);
@@ starter
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

char *rleEncode(const char *s) {
    // TODO
    return NULL;
}
@@ solution
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

char *rleEncode(const char *s) {
    /* pass 1: exact length */
    size_t total = 0;
    for (const char *p = s; *p; ) {
        const char *q = p;
        while (*q == *p) q++;
        total += 1 + (size_t)snprintf(NULL, 0, "%d", (int)(q - p));
        p = q;
    }
    char *out = malloc(total + 1);
    if (out == NULL) return NULL;
    /* pass 2: write */
    char *w = out;
    for (const char *p = s; *p; ) {
        const char *q = p;
        while (*q == *p) q++;
        w += sprintf(w, "%c%d", *p, (int)(q - p));
        p = q;
    }
    *w = '\0';
    return out;
}
@@ driver
#include "lc_driver.h"

int main(void)
{
    while (lc_next_case()) {
        char *s = lc_read_str();
        char *r;
        lc_make_readonly(s);
        r = rleEncode(s);
        if (!r) {
            lc_fail("rleEncode returned NULL. Return a malloc'd string (also when it is empty).");
            lc_out_null();
        } else {
            lc_out_str(r);
            LC_FREE_RESULT(r, "the string returned by rleEncode()");
        }
        lc_end_case();
    }
    return lc_finish();
}
@@ tests
"a"

"abc"

"aabbbaa"

"zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"

"aaaaaaaaab"

"aaaaaaaaaab"

"  !!"
@@ editorial
## Approach: measure exactly, then write

```c
char *rleEncode(const char *s) {
    size_t total = 0;                              // pass 1: exact size
    for (const char *p = s; *p; ) {
        const char *q = p;
        while (*q == *p) q++;                      // q = end of the run
        total += 1 + (size_t)snprintf(NULL, 0, "%d", (int)(q - p));
        p = q;
    }
    char *out = malloc(total + 1);
    if (out == NULL) return NULL;
    char *w = out;                                 // pass 2: write
    for (const char *p = s; *p; ) {
        const char *q = p;
        while (*q == *p) q++;
        w += sprintf(w, "%c%d", *p, (int)(q - p)); // sprintf returns chars written
        p = q;
    }
    *w = '\0';
    return out;
}
```

### `snprintf(NULL, 0, ...)` measures
With a NULL buffer and size 0, `snprintf` writes nothing and returns how many characters the output *would* have. It is the standard way to size a buffer before formatting into it.

### Upper bound alternative
Each run of length `k` costs `1 + digits(k) <= 1 + k` characters, so the output never exceeds `2 * strlen(s)`. Allocating `2 * strlen(s) + 1` bytes and writing in one pass is simpler; follow it with `realloc` to shrink if memory matters.

### Why the inner `while (*q == *p)` stops at the end
The `'\0'` never equals a real character, so the run ends at the terminator without a separate length check.

**Complexity:** O(n) time, O(output) memory.

@@@ problem ring-buffer
@@ meta
{
  "title": "Ring Buffer",
  "difficulty": "Medium",
  "topics": ["Design", "Arrays", "Fixed capacity"],
  "kind": "design",
  "params": [{"name": "capacity", "type": "int"}, {"name": "operations", "type": "string[]"}, {"name": "arguments", "type": "any[][]"}],
  "examples": [
    {"input": ["3", "[\"enqueue\",\"enqueue\",\"enqueue\",\"enqueue\",\"rear\",\"isFull\",\"dequeue\",\"enqueue\",\"rear\"]", "[[1],[2],[3],[4],[],[],[],[4],[]]"], "output": "[true,true,true,false,3,true,true,true,4]", "explanation": "The 4th enqueue fails because the buffer is full. After a dequeue there is room again, and the new element wraps around to the front of the array."}
  ],
  "hints": [
    "Store a head index and a count. The tail is (head + count) % capacity.",
    "Dequeue just advances head: head = (head + 1) % capacity.",
    "Allocate the array once in rbCreate: enqueue and dequeue never allocate."
  ],
  "constraints": ["1 <= capacity <= 1000", "front and rear return -1 when the buffer is empty"],
  "memory": "All memory is allocated in `rbCreate`. `rbEnqueue`/`rbDequeue` must not allocate or free. `rbFree` releases everything."
}
@@ description
A **ring buffer** (circular queue) stores up to `capacity` elements in a fixed array. When the end of the array is reached, it wraps around to the beginning, so no memory is ever moved or reallocated: ideal for audio buffers, network packets, logs and keyboard input.

```c
typedef struct RingBuffer RingBuffer;

RingBuffer *rbCreate(int capacity);
bool rbEnqueue(RingBuffer *q, int value);   // false if full
bool rbDequeue(RingBuffer *q);              // false if empty
int  rbFront(const RingBuffer *q);          // -1 if empty
int  rbRear(const RingBuffer *q);           // -1 if empty
bool rbIsEmpty(const RingBuffer *q);
bool rbIsFull(const RingBuffer *q);
void rbFree(RingBuffer *q);
```

The harness calls `rbCreate(capacity)`, runs the operations, then `rbFree`. It checks that no allocations happen after creation.
