@@ editorial
## Approach: recursive delete with the successor rule

```c
struct TreeNode *deleteNode(struct TreeNode *root, int key) {
    if (root == NULL) return NULL;                       // not found
    if (key < root->val) {
        root->left = deleteNode(root->left, key);
    } else if (key > root->val) {
        root->right = deleteNode(root->right, key);
    } else if (root->left == NULL || root->right == NULL) {
        struct TreeNode *child = root->left ? root->left : root->right;
        free(root);                                      // this node leaves the tree
        return child;                                    // the parent links to the child
    } else {
        struct TreeNode *succ = root->right;             // smallest in the right subtree
        while (succ->left != NULL) succ = succ->left;
        root->val = succ->val;                           // take its value
        root->right = deleteNode(root->right, succ->val);   // and delete it there
    }
    return root;
}
```

### Why the successor works
The smallest value in the right subtree is larger than everything on the left and smaller than everything else on the right, so it can sit in the deleted node's place without breaking the BST order. It has no left child, so deleting it falls into the easy "at most one child" case.

### Exactly one `free`
In the two-children case the node holding `key` stays in the tree with a new value; the successor's node is the one freed (by the recursive call). Freeing `root` there too would leave the parent pointing at freed memory.

**Complexity:** O(height) time, no extra memory besides the recursion.

@@@ problem serialize-a-binary-tree
@@ meta
{
  "title": "Serialize a Binary Tree",
  "difficulty": "Medium",
  "topics": ["Binary tree", "Strings", "realloc"],
  "params": [{"name": "root", "type": "tree"}],
  "examples": [
    {"input": ["[1,2,3,null,null,4,5]"], "output": "\"1,2,#,#,3,4,#,#,5,#,#\"", "explanation": "Pre-order: each node prints its value, then its left subtree, then its right subtree; '#' stands for a missing child."},
    {"input": ["[]"], "output": "\"#\""}
  ],
  "hints": [
    "Write a recursive helper that appends to a growable buffer.",
    "A value needs at most 11 characters (\"-2147483648\"); grow the buffer before each append if needed.",
    "Separate tokens with commas: write a comma before every token except the first."
  ],
  "constraints": ["0 <= number of nodes <= 10^4", "-10^5 <= node values <= 10^5"],
  "memory": "Return one `malloc`'d string; the caller frees it. Free any temporary buffers you use."
}
@@ description
Turn a binary tree into a string, using a **pre-order** traversal: the node's value, then its left subtree, then its right subtree. Write `#` for a missing child, and separate all tokens with commas.

```c
char *serialize(const struct TreeNode *root);
```

```
    1
   / \
  2   3        →  "1,2,#,#,3,4,#,#,5,#,#"
     / \
    4   5
```

You can't know the length of the result in advance without a first pass, so this is a good place for the growable buffer you built in *String Builder*.
@@ prelude
struct TreeNode {
    int val;
    struct TreeNode *left;
    struct TreeNode *right;
};
char *serialize(const struct TreeNode *root);
@@ starter
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

/* struct TreeNode { int val; struct TreeNode *left; struct TreeNode *right; }; */

char *serialize(const struct TreeNode *root) {
    // TODO
    return NULL;
}
@@ solution
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

typedef struct {
    char *buf;
    size_t len, cap;
} Buf;

static int put(Buf *b, const char *token) {
    size_t n = strlen(token) + 1;              /* token plus a comma or '\0' */
    if (b->len + n + 1 > b->cap) {
        size_t cap = b->cap ? b->cap * 2 : 64;
        while (cap < b->len + n + 1) cap *= 2;
        char *bigger = realloc(b->buf, cap);
        if (bigger == NULL) return 0;
        b->buf = bigger;
        b->cap = cap;
    }
    if (b->len > 0) b->buf[b->len++] = ',';
    memcpy(b->buf + b->len, token, n);         /* copies the '\0' too */
    b->len += n - 1;
    return 1;
}

static int walk(Buf *b, const struct TreeNode *t) {
    if (t == NULL) return put(b, "#");
    char num[16];
    snprintf(num, sizeof num, "%d", t->val);
    return put(b, num) && walk(b, t->left) && walk(b, t->right);
}

char *serialize(const struct TreeNode *root) {
    Buf b = { NULL, 0, 0 };
    if (!walk(&b, root)) {
        free(b.buf);
        return NULL;
    }
    return b.buf;
}
@@ driver
#include "lc_driver.h"
#define LC_WANT_TREE
#include "lc_ds.h"

int main(void)
{
    while (lc_next_case()) {
        struct TreeNode *root = lc_read_tree();
        char *s = serialize(root);
        if (!s) {
            lc_fail("serialize returned NULL.");
            lc_out_null();
        } else {
            lc_out_str(s);
            LC_FREE_RESULT(s, "the string returned by serialize()");
        }
        lc_free_tree(root, "a node of the input tree");
        lc_end_case();
    }
    return lc_finish();
}
@@ tests
[1]

[-1,null,-2]

[10,20,30,40,50,60,70]

[100000,-100000]

[1,2,null,3,null,4,null,5]
@@ editorial
## Approach: pre-order walk into a growable buffer

```c
typedef struct { char *buf; size_t len, cap; } Buf;

static int put(Buf *b, const char *token) {          // append ",token"
    size_t n = strlen(token) + 1;
    if (b->len + n + 1 > b->cap) {                    // grow geometrically
        size_t cap = b->cap ? b->cap * 2 : 64;
        while (cap < b->len + n + 1) cap *= 2;
        char *bigger = realloc(b->buf, cap);
        if (bigger == NULL) return 0;
        b->buf = bigger;
        b->cap = cap;
    }
    if (b->len > 0) b->buf[b->len++] = ',';
    memcpy(b->buf + b->len, token, n);                // includes the '\0'
    b->len += n - 1;
    return 1;
}

static int walk(Buf *b, const struct TreeNode *t) {
    if (t == NULL) return put(b, "#");
    char num[16];
    snprintf(num, sizeof num, "%d", t->val);
    return put(b, num) && walk(b, t->left) && walk(b, t->right);
}

char *serialize(const struct TreeNode *root) {
    Buf b = { NULL, 0, 0 };
    if (!walk(&b, root)) { free(b.buf); return NULL; }
    return b.buf;                                     // ownership passes to the caller
}
```

### Why pre-order with null markers?
Pre-order plus explicit `#` markers determines the tree uniquely, so a matching `deserialize` can rebuild it by reading tokens in the same order. In-order alone can't: `[1,2]` and `[2,null,1]` give the same in-order sequence.

### Returning the buffer itself
The buffer was allocated by `realloc`, so it is a normal heap block. Returning it hands ownership to the caller. It may be up to 2x larger than needed; `realloc(b.buf, b.len + 1)` would trim it.

**Complexity:** O(n) time, O(n) memory.
