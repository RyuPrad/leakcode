@@ editorial
## Approach: count, then cut

```c
char **splitString(const char *s, char delim, int *returnSize) {
    int count = 1;
    for (const char *p = s; *p; p++)
        if (*p == delim) count++;
    char **tokens = malloc(count * sizeof *tokens);
    int k = 0;
    const char *start = s;                    // start of the current token
    for (const char *p = s; ; p++) {
        if (*p == delim || *p == '\0') {      // the current token ends at p
            size_t len = (size_t)(p - start);
            tokens[k] = malloc(len + 1);
            memcpy(tokens[k], start, len);
            tokens[k][len] = '\0';
            k++;
            if (*p == '\0') break;
            start = p + 1;
        }
    }
    *returnSize = count;
    return tokens;
}
```

### Why not `strtok`?
`strtok` writes `'\0'` into the string it scans (impossible on a `const char *` or a literal), keeps hidden global state between calls, and treats consecutive delimiters as one, so empty tokens disappear. It is best avoided.

### Freeing the result
```c
for (int i = 0; i < n; i++) free(tokens[i]);
free(tokens);
```
Freeing only `tokens` leaks every string; freeing the strings after `tokens` reads freed memory.

**Complexity:** O(n) time and memory.

@@@ problem pascals-triangle
@@ meta
{
  "title": "Pascal's Triangle",
  "difficulty": "Medium",
  "topics": ["Jagged arrays", "malloc", "LeetCode conventions"],
  "params": [{"name": "numRows", "type": "int"}],
  "examples": [
    {"input": ["5"], "output": "[[1],[1,1],[1,2,1],[1,3,3,1],[1,4,6,4,1]]", "explanation": "Row i has i + 1 numbers; inner numbers are the sum of the two above."},
    {"input": ["1"], "output": "[[1]]"}
  ],
  "hints": [
    "Row i needs its own block of i + 1 ints: the rows have different lengths (a jagged array).",
    "row[i][0] = row[i][i] = 1; row[i][j] = row[i-1][j-1] + row[i-1][j]."
  ],
  "constraints": ["1 <= numRows <= 30"],
  "memory": "Same convention as *Transpose a Matrix*: return the row array, set `*returnSize`, and set `*returnColumnSizes` to a new array of row lengths. The caller frees everything."
}
@@ description
Generate the first `numRows` rows of Pascal's triangle.

```c
int **generate(int numRows, int *returnSize, int **returnColumnSizes);
```

```
        1
       1 1
      1 2 1
     1 3 3 1
```

Each row is longer than the previous one, so this is a **jagged array**: a row array whose rows have different lengths. That is easy with an array of pointers, and impossible with a plain `int grid[R][C]`.
@@ prelude
int **generate(int numRows, int *returnSize, int **returnColumnSizes);
@@ starter
#include <stdlib.h>

int **generate(int numRows, int *returnSize, int **returnColumnSizes) {
    // TODO
    *returnSize = 0;
    *returnColumnSizes = NULL;
    return NULL;
}
@@ solution
#include <stdlib.h>

int **generate(int numRows, int *returnSize, int **returnColumnSizes) {
    int **rows = malloc(numRows * sizeof *rows);
    int *sizes = malloc(numRows * sizeof *sizes);
    for (int i = 0; i < numRows; i++) {
        rows[i] = malloc((i + 1) * sizeof *rows[i]);
        sizes[i] = i + 1;
        rows[i][0] = rows[i][i] = 1;
        for (int j = 1; j < i; j++)
            rows[i][j] = rows[i - 1][j - 1] + rows[i - 1][j];
    }
    *returnSize = numRows;
    *returnColumnSizes = sizes;
    return rows;
}
@@ driver
#include "lc_driver.h"

int main(void)
{
    while (lc_next_case()) {
        int n = lc_read_int(), rs = -1, *rcs = NULL, r;
        int **rows = generate(n, &rs, &rcs);
        if (rs < 0 || (rs > 0 && (!rows || !rcs))) {
            lc_fail("Set *returnSize and *returnColumnSizes, and return the rows.");
            lc_out_null();
        } else {
            lc_out_begin();
            for (r = 0; r < rs; r++) lc_out_int_array(rows[r], rcs[r]);
            lc_out_end();
            for (r = 0; r < rs; r++) LC_FREE_RESULT(rows[r], "a row returned by generate()");
        }
        if (rows) LC_FREE_RESULT(rows, "the row array returned by generate()");
        if (rcs) LC_FREE_RESULT(rcs, "the *returnColumnSizes array");
        lc_end_case();
    }
    return lc_finish();
}
@@ tests
2

3

10

20

30
@@ editorial
## Approach: build each row from the previous one

```c
int **generate(int numRows, int *returnSize, int **returnColumnSizes) {
    int **rows = malloc(numRows * sizeof *rows);
    int *sizes = malloc(numRows * sizeof *sizes);
    for (int i = 0; i < numRows; i++) {
        rows[i] = malloc((i + 1) * sizeof *rows[i]);    // row i has i + 1 entries
        sizes[i] = i + 1;
        rows[i][0] = rows[i][i] = 1;
        for (int j = 1; j < i; j++)
            rows[i][j] = rows[i - 1][j - 1] + rows[i - 1][j];
    }
    *returnSize = numRows;
    *returnColumnSizes = sizes;
    return rows;
}
```

### Jagged arrays
`rows[i]` points to a block of exactly `i + 1` ints. Reading `rows[i][i + 1]` is out of bounds even though a "rectangular" mental model suggests it exists. The guard pages around each row catch that immediately.

### How much memory?
`numRows` row pointers plus `1 + 2 + ... + numRows = numRows(numRows+1)/2` ints. A rectangular `numRows x numRows` array would waste almost half.

**Complexity:** O(numRows²) time and memory.
