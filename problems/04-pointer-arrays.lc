@@ editorial
## Approach: allocate cols rows of length rows

```c
int **transpose(int **matrix, int matrixSize, int *matrixColSize,
                int *returnSize, int **returnColumnSizes) {
    int rows = matrixSize, cols = matrixColSize[0];
    int **t = malloc(cols * sizeof *t);
    int *sizes = malloc(cols * sizeof *sizes);
    for (int c = 0; c < cols; c++) {
        t[c] = malloc(rows * sizeof *t[c]);
        sizes[c] = rows;
        for (int r = 0; r < rows; r++)
            t[c][r] = matrix[r][c];
    }
    *returnSize = cols;
    *returnColumnSizes = sizes;      // hand the array to the caller
    return t;
}
```

### Reading the signature
- `int *returnSize`: the caller's `int`. You write the count through it.
- `int **returnColumnSizes`: the caller's `int *`. You write a *pointer* through it.

In the caller it looks like this:
```c
int rs, *colSizes;
int **t = transpose(m, rows, cols, &rs, &colSizes);
/* ... use t ... */
for (int i = 0; i < rs; i++) free(t[i]);
free(t);
free(colSizes);
```

(For brevity the solution skips the `NULL` checks after `malloc`. Production code should check each one, as in *Allocate and Free a Matrix*.)

**Complexity:** O(rows * cols) time and memory.

@@@ problem split-a-string
@@ meta
{
  "title": "Split a String",
  "difficulty": "Medium",
  "topics": ["Strings", "Arrays of pointers", "malloc"],
  "params": [{"name": "s", "type": "string"}, {"name": "delim", "type": "char"}],
  "examples": [
    {"input": ["\"a,b,c\"", "\",\""], "output": "[\"a\",\"b\",\"c\"]"},
    {"input": ["\"a,,b\"", "\",\""], "output": "[\"a\",\"\",\"b\"]", "explanation": "Two delimiters in a row produce an empty token."},
    {"input": ["\"\"", "\",\""], "output": "[\"\"]", "explanation": "No delimiter: one token, the whole (empty) string."}
  ],
  "hints": [
    "The number of tokens is (number of delimiters) + 1. Count them first to size the array.",
    "Each token is a separate malloc'd string of length (end - start) + 1.",
    "Don't use strtok: it modifies its input (and s is const) and skips empty tokens."
  ],
  "constraints": ["0 <= strlen(s) <= 10^4"],
  "memory": "Return a `malloc`'d array of `*returnSize` pointers, each pointing to its own `malloc`'d string. The caller frees every token, then the array."
}
@@ description
Split `s` at every occurrence of the character `delim` and return the pieces.

```c
char **splitString(const char *s, char delim, int *returnSize);
```

- Every delimiter separates two tokens, so `k` delimiters give `k + 1` tokens (some may be empty).
- Each token must be its **own** heap string, and the array of pointers must be its own block too. The caller frees each token and then the array.
- `s` is read-only.

The result has two levels of ownership: the array owns the token pointers, and each token owns its characters.
@@ prelude
char **splitString(const char *s, char delim, int *returnSize);
@@ starter
#include <stdlib.h>
#include <string.h>

char **splitString(const char *s, char delim, int *returnSize) {
    // TODO
    *returnSize = 0;
    return NULL;
}
@@ solution
#include <stdlib.h>
#include <string.h>

char **splitString(const char *s, char delim, int *returnSize) {
    int count = 1;
    for (const char *p = s; *p; p++)
        if (*p == delim) count++;
    char **tokens = malloc(count * sizeof *tokens);
    int k = 0;
    const char *start = s;
    for (const char *p = s; ; p++) {
        if (*p == delim || *p == '\0') {
            size_t len = (size_t)(p - start);
            tokens[k] = malloc(len + 1);
            memcpy(tokens[k], start, len);
            tokens[k][len] = '\0';
            k++;
            if (*p == '\0') break;
            start = p + 1;
        }
    }
    *returnSize = count;
    return tokens;
}
@@ driver
#include "lc_driver.h"

int main(void)
{
    while (lc_next_case()) {
        char *s = lc_read_str();
        char *d = lc_read_str();
        int count = -1, i;
        char **tokens;
        if (!d || strlen(d) != 1) lc_abort_case("Invalid test case", "delim must be a single character.");
        lc_make_readonly(s);
        tokens = splitString(s, d[0], &count);
        if (count < 0 || (count > 0 && !tokens)) {
            lc_fail("Set *returnSize and return the array of tokens.");
            lc_out_null();
        } else {
            lc_out_str_array(tokens, count);
            for (i = 0; i < count; i++) LC_FREE_RESULT(tokens[i], "a token returned by splitString()");
        }
        if (tokens) LC_FREE_RESULT(tokens, "the token array returned by splitString()");
        lc_end_case();
    }
    return lc_finish();
}
