@@ editorial
## Approach: one block for the row pointers, one block per row

```c
int **createMatrix(int rows, int cols, int value) {
    int **m = malloc(rows * sizeof *m);          // rows pointers
    if (m == NULL) return NULL;
    for (int r = 0; r < rows; r++) {
        m[r] = malloc(cols * sizeof *m[r]);      // cols ints
        if (m[r] == NULL) {                      // clean up a partial matrix
            while (r-- > 0) free(m[r]);
            free(m);
            return NULL;
        }
        for (int c = 0; c < cols; c++) m[r][c] = value;
    }
    return m;
}

void freeMatrix(int **matrix, int rows) {
    if (matrix == NULL) return;
    for (int r = 0; r < rows; r++)
        free(matrix[r]);     // rows first: we still need matrix[r]
    free(matrix);            // then the array that held them
}
```

### Order matters
Freeing `matrix` first and then reading `matrix[r]` reads freed memory. Free *contents before containers*.

### Alternative: a single block
```c
int **m = malloc(rows * sizeof(int *) + rows * cols * sizeof(int));
int *data = (int *)(m + rows);                  // ints start after the pointers
for (int r = 0; r < rows; r++) m[r] = data + r * cols;
/* freeMatrix is then just free(m) */
```
One allocation is faster and can't partially fail, but only the code that created it knows it must be freed with a single `free`, which is exactly why the library provides `freeMatrix`.

### `sizeof *m` vs `sizeof *m[r]`
`*m` is an `int *` (8 bytes) and `*m[r]` is an `int` (4 bytes). Mixing them up allocates the wrong amount without any compiler warning.

**Complexity:** O(rows * cols) time and memory.

@@@ problem transpose-matrix
@@ meta
{
  "title": "Transpose a Matrix (LeetCode Style)",
  "difficulty": "Medium",
  "topics": ["2D arrays", "malloc", "LeetCode conventions"],
  "params": [{"name": "matrix", "type": "int[][]"}],
  "examples": [
    {"input": ["[[1,2,3],[4,5,6]]"], "output": "[[1,4],[2,5],[3,6]]", "explanation": "A 2x3 matrix becomes 3x2: *returnSize = 3 and every (*returnColumnSizes)[i] = 2."},
    {"input": ["[[1]]"], "output": "[[1]]"}
  ],
  "hints": [
    "The result has cols rows and rows columns: result[c][r] = matrix[r][c].",
    "*returnColumnSizes must point to a malloc'd array of *returnSize ints.",
    "Allocate: the row array, each row, and the column-sizes array. That is cols + 2 allocations."
  ],
  "constraints": ["1 <= matrixSize <= 100", "1 <= matrixColSize[i] <= 100", "all rows have the same length"],
  "memory": "Return a newly allocated matrix. Set `*returnSize` to its number of rows and `*returnColumnSizes` to a newly allocated array of row lengths. The caller frees every row, the row array, and the column-sizes array."
}
@@ description
Return the **transpose** of `matrix`: rows become columns.

```c
int **transpose(int **matrix, int matrixSize, int *matrixColSize,
                int *returnSize, int **returnColumnSizes);
```

This is exactly how LeetCode passes and returns 2D arrays in C, so it is worth learning once:

| Parameter | Meaning |
|---|---|
| `matrix`, `matrixSize` | the input rows and how many there are |
| `matrixColSize` | an array: `matrixColSize[i]` is the length of row `i` |
| `*returnSize` | **you** set it: the number of rows you return |
| `*returnColumnSizes` | **you** set it to a `malloc`'d array holding each returned row's length |

`int **returnColumnSizes` is a pointer to the caller's `int *` variable, so you write `*returnColumnSizes = malloc(...)` to hand the array back.
@@ prelude
int **transpose(int **matrix, int matrixSize, int *matrixColSize, int *returnSize, int **returnColumnSizes);
@@ starter
#include <stdlib.h>

int **transpose(int **matrix, int matrixSize, int *matrixColSize,
                int *returnSize, int **returnColumnSizes) {
    // TODO
    *returnSize = 0;
    *returnColumnSizes = NULL;
    return NULL;
}
@@ solution
#include <stdlib.h>

int **transpose(int **matrix, int matrixSize, int *matrixColSize,
                int *returnSize, int **returnColumnSizes) {
    int rows = matrixSize, cols = matrixColSize[0];
    int **t = malloc(cols * sizeof *t);
    int *sizes = malloc(cols * sizeof *sizes);
    for (int c = 0; c < cols; c++) {
        t[c] = malloc(rows * sizeof *t[c]);
        sizes[c] = rows;
        for (int r = 0; r < rows; r++)
            t[c][r] = matrix[r][c];
    }
    *returnSize = cols;
    *returnColumnSizes = sizes;
    return t;
}
@@ driver
#include "lc_driver.h"

int main(void)
{
    while (lc_next_case()) {
        int rows, *cols, r, rs = -1, *rcs = NULL;
        int **m = lc_read_int_matrix(&rows, &cols);
        int **t;
        for (r = 0; r < rows; r++) lc_make_readonly(m[r]);
        lc_make_readonly(m);
        lc_make_readonly(cols);
        t = transpose(m, rows, cols, &rs, &rcs);
        if (rs < 0 || (rs > 0 && (!t || !rcs))) {
            lc_fail("Set *returnSize and *returnColumnSizes, and return the matrix.");
            lc_out_null();
        } else {
            lc_out_begin();
            for (r = 0; r < rs; r++) lc_out_int_array(t[r], rcs[r]);
            lc_out_end();
            for (r = 0; r < rs; r++) LC_FREE_RESULT(t[r], "a row of the matrix returned by transpose()");
        }
        if (t) LC_FREE_RESULT(t, "the row array returned by transpose()");
        if (rcs) LC_FREE_RESULT(rcs, "the *returnColumnSizes array");
        lc_end_case();
    }
    return lc_finish();
}
@@ tests
[[1,2],[3,4]]

[[1],[2],[3]]

[[5,6,7,8]]

