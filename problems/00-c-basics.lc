    "`if (b > largest) { largest = b; }` replaces the current best only when `b` beats it."
  ],
  "constraints": ["-10^9 <= a, b, c <= 10^9"]
}
@@ description
Return the largest of the three numbers `a`, `b` and `c`.

```c
int largestOfThree(int a, int b, int c);
```
@@ prelude
int largestOfThree(int a, int b, int c);
@@ starter
int largestOfThree(int a, int b, int c) {
    // TODO: compare the numbers and return the largest.
    return 0;
}
@@ solution
int largestOfThree(int a, int b, int c) {
    int largest = a;
    if (b > largest) {
        largest = b;
    }
    if (c > largest) {
        largest = c;
    }
    return largest;
}
@@ driver
#include "lc_driver.h"

int main(void)
{
    while (lc_next_case()) {
        int a = lc_read_int();
        int b = lc_read_int();
        int c = lc_read_int();
        lc_out_int(largestOfThree(a, b, c));
        lc_end_case();
    }
    return lc_finish();
}
@@ tests
